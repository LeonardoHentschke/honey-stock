# =============================================================================
# Honey Stock — ambiente de DESENVOLVIMENTO (Supabase local)
# =============================================================================
# Carregado pelo Expo quando NODE_ENV=development (expo start / expo run:android)
# e tem prioridade sobre o .env. O .env continua apontando para o banco remoto
# e é o que vale em builds de produção.
#
# A anon key abaixo é a key demo padrão do Supabase CLI local — é pública e
# igual para todo mundo, por isso este arquivo PODE ser commitado.
#
# URL: 10.0.2.2 = localhost da máquina visto de dentro do emulador Android.
# Em dispositivo físico, troque pelo IP da máquina na rede (ex.: 192.168.x.x).

EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

EXPO_PUBLIC_PROJECT_ID=
